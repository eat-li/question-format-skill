{
  "name": "question-format-skill",
  "version": "1.1.0",
  "description": "把题目文本整理成规范 HTML 的 Agent Skill：KaTeX 公式归一、防泄题兜底、数字/选项守恒守卫",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eat-li/question-format-skill.git"
  },
  "bugs": {
    "url": "https://github.com/eat-li/question-format-skill/issues"
  },
  "homepage": "https://github.com/eat-li/question-format-skill#readme",
  "engines": {
    "node": ">=18.13"
  },
  "bin": {
    "qformat": "bin/qformat.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./clean": "./src/clean.mjs",
    "./strip-answer": "./src/strip-answer.mjs",
    "./normalize-math": "./src/normalize-math.mjs",
    "./guard": "./src/guard.mjs"
  },
  "files": [
    "bin",
    "src",
    "references",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "format": "node bin/qformat.mjs format",
    "repair": "node bin/qformat.mjs repair",
    "verify": "node bin/qformat.mjs verify",
    "guard": "node bin/qformat.mjs guard"
  },
  "optionalDependencies": {
    "katex": "^0.16.11"
  },
  "keywords": [
    "ai",
    "skill",
    "claude-skill",
    "math",
    "latex",
    "katex",
    "question-bank",
    "formatting",
    "llm"
  ]
}
